# Copy this to .env and fill in real values — never commit .env to git

# Blockchain RPC providers (use QuickNode / Alchemy / Helius)
TRON_API_KEY=your_trongrid_api_key
BSC_RPC_URL=https://bsc-dataseed.binance.org/
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com

# 32-byte hex key for AES-256 encryption of private keys
ENCRYPTION_KEY=your_32_byte_hex_key_here

# Override DB/Redis/Rabbit passwords for production
POSTGRES_PASSWORD=change_in_production
REDIS_PASSWORD=change_in_production
RABBITMQ_PASSWORD=change_in_production
